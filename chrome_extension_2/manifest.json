{
  "manifest_version": 3,
  "name": "Durin MiniLM",
  "version": "2.0.0",
  "description": "Blocks off-task tabs with local MiniLM title embeddings, plus URL and domain blacklist/whitelist.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Durin MiniLM"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
